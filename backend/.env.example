APP_NAME=Viora AI - Image Quality & Defect Detection
APP_VERSION=1.0.0

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

DATABASE_NAME=image_quality_db

MAX_FILE_SIZE_MB=10

UPLOAD_DIR=uploads

MODEL_NAME=ImageQualityNet
MODEL_VERSION=0.1.0

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://viora-ai-intelligent-image-quality.vercel.app,https://viora-ai-intelligent-image-quality.vercel.app
